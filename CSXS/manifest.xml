<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest ExtensionBundleId="com.kvnlibrary.youtubeimporter"
    ExtensionBundleName="YouTube Importer"
    ExtensionBundleVersion="1.0.0"
    Version="9.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.kvnlibrary.youtubeimporter.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- PPRO 13.0 = Premiere Pro 2019. Kept low/wide on purpose: RequiredRuntime
           below is what actually gates CEP feature availability, so there is no
           benefit to also narrowing the Premiere version range here. -->
      <Host Name="PPRO" Version="[13.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.kvnlibrary.youtubeimporter.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Enables require()/fs/child_process/os/path/crypto directly inside the
                 panel's own JS context (the "mixed context" model). This is what lets
                 the frontend call the Node.js backend modules under /backend without a
                 separate server process. See README.md > Arquitetura for details. -->
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>YouTube Importer</Menu>
          <Geometry>
            <Size>
              <Height>760</Height>
              <Width>420</Width>
            </Size>
            <MinSize>
              <Height>500</Height>
              <Width>340</Width>
            </MinSize>
            <MaxSize>
              <Height>2000</Height>
              <Width>900</Width>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/icon-normal.png</Icon>
            <Icon Type="RollOver">./icons/icon-rollover.png</Icon>
            <Icon Type="Disabled">./icons/icon-disabled.png</Icon>
            <Icon Type="DarkNormal">./icons/icon-dark-normal.png</Icon>
            <Icon Type="DarkRollOver">./icons/icon-dark-rollover.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
