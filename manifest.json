{
  "id": "com.kvn.library",
  "name": "KVN Library",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request",
    "launchProcess": {
      "extensions": ["wav", "mp3", "aac", "m4a", "aif", "aiff", ".wav", ".mp3", ".aac", ".m4a", ".aif", ".aiff"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "kvnLibraryPanel",
      "label": {
        "default": "KVN Library"
      },
      "minimumSize": {
        "width": 260,
        "height": 360
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 680
      }
    }
  ]
}
